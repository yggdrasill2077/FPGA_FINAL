//==============================================================================
// shape_recog.v 鈥斺€?褰㈢姸璇嗗埆锛堥樁娈典簩路鏈€灏忓彲婕旂ず鐗堬級
//
//   璧涢楂橀樁绗?6 椤癸細鍦嗗舰 / 鐭╁舰 / 鏈煡 涓夌被锛屽彧澶勭悊鐢婚潰涓渶澶х殑鐩爣銆?//   鏄庣‘涓嶅仛锛欳CL 杩為€氬煙銆佸鐩爣銆佸绉伴樁銆佷笁瑙掑舰/鍗佸瓧缁嗗垎銆佹眽瀛?OSD銆?//
//   缁撴瀯
//   鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
//   [stat] 閫愬儚绱犲崟閬嶇疮鍔狅紙2 鍍忕礌/鏃堕挓锛屾寕涓€兼护娉㈣緭鍑猴級
//        A / 危x / 危y / 危xx / 危yy / 危xy / bbox
//        鍓嶆櫙 = POLARITY ? (gray <= THRESH) : (gray > THRESH)
//        A 涓€鏃?鈮?30721 灏卞喕缁撶疮鍔?鈫?鎵€鏈夌疮鍔犲櫒瀹藉害鏈夐檺涓旀暟瀛︿笂姘镐笉婧㈠嚭
//        鍙屽儚绱犲悓鎷嶏細x0 = 2*pcol, x1 = x0+1
//        x0虏 / x1虏 / y路x0 / y路x1 鍏ㄩ儴鐢ㄣ€屽閲忓瘎瀛樺櫒銆嶉鍏堢敓鎴愶紝
//        姣忔媿鍙墿涓€绾у姞娉?+ 浜岄€変竴锛岄伩鍏?11x11 涔樻硶鍣ㄨ繘鍏?74.25MHz 璺緞
//
//   [math] 甯ф湯涓茶涔橀櫎寮曟搸锛堜竴鍙板叡浜暟鎹€氳矾锛屼竴甯у彧璺戜竴娆★級
//        P   = A路危xx 鈭?危x虏      Q = A路危yy 鈭?危y虏      R = A路危xy 鈭?危x路危y
//        m20 = P路2^12/A虏        m02 = Q路2^12/A虏      m11 = R路2^12/A虏   (Q12)
//        tr  = m20 + m02
//        c_g = A/(蟺路tr) 鈮?1.965   鉄?  A路10616 鈮?tr          鈫?鏃犻櫎娉曘€佹棤寮€鏂?//        LQ  = (m20>>4)(m02>>4) 鈭?(m11>>4)虏 ,  W = LQ/A虏
//        f_mom 鈮?0.965 鉄?LQ 鈮?125112路A虏                        鈫?鐢?f_mom虏 娑堟帀寮€鏂广€佸啀娑堟帀闄ゆ硶
//        鍒ゅ簭锛氶潰绉棬闄?鈫?鍦?鈫?鐭?鈫?鏈煡锛堚槄鍦嗗繀椤绘帓鍦ㄧ煩褰箣鍓嶏級
//
//   鏁板涓婁负浠€涔堢敤 P/Q/R 鑰屼笉鏄?危xx/A 鈭?cx虏锛?//        鍚庤€呭湪鐩爣鍋忕鐢婚潰鍘熺偣鏃朵袱涓ぇ鏁扮浉鍑忥紝瀹氱偣浼氫涪 ~10bit锛汸/Q/R 鏄簿纭?//        鏁存暟鍒嗗瓙锛堝钩琛岃酱鍏紡鐨勬暣鏁板舰寮忥級锛岄櫎娉曞彧鍦ㄦ渶鍚庡仛涓€娆°€?//
//   鍧愭爣鍙ｅ緞
//        x = 0 .. 2*H_PAIRS-1锛堝悓鎷嶄袱鍍忕礌鏄浉閭诲垪锛?//        y = 0 .. V_LINES-1
//==============================================================================
module shape_recog #(
    parameter integer H_PAIRS  = 960,        // 琛屽唴鍍忕礌瀵规暟锛?920/2锛?    parameter integer V_LINES  = 1080,       // 甯ц鏁?    parameter [7:0]   THRESH   = 8'd128,     // 鍓嶆櫙鐏板害闃堝€硷紙AUTO_TH=0 鏃朵娇鐢級
    parameter         POLARITY = 1'b0,       // 0: gray>TH 涓哄墠鏅紱1: 鍙嶇浉
    // ---- 鑷€傚簲闃堝€?+ bbox 鍚堢悊鎬ф嫆缁濓紙2026-10-24 R3锛?---
    parameter integer TH_MODE  = 0,          // 0 = 鍥哄畾 THRESH + 鑷姩鏋佹€э紙鍙娴嬶級锛? = 鐩稿甯у潎鍊硷紙鐏垫晱搴﹂珮浣嗘槗鎶婅儗鏅畻杩涙潵锛?    parameter [7:0]   TH_DELTA = 8'd24,      // TH_MODE=1 鏃朵笌甯у潎鍊肩殑鍋忓樊闂ㄩ檺
    parameter integer BBX_MAX  = 1800,       // bbox 瀹藉害涓婇檺锛堣秴闄愬垽涓鸿儗鏅?鏉傜墿锛?    parameter integer BBY_MAX  = 1000,        // bbox 楂樺害涓婇檺
    parameter integer A_MIN    = 150,        // 鏈€灏忛潰绉紙16 鏍锋湰 = 1 鏍锋湰脳16锛夛紝浣庝簬姝ゅ垽鍣０
    parameter integer FILL_MIN = 297         // 濉厖搴︿笅闄愶紙Q10锛欰_true/bbox_px 鈮?297/1024 鈮?0.29锛?    
)(
    input  wire        clk,                  // vid_clk_dvi2 (74.25MHz, 2ppc)
    input  wire        rst_n,                // vid_rst_n
    input  wire        i_de,                 // med_de
    input  wire        i_vs,                 // med_vs
    input  wire [7:0]  i_g0,                 // med_g0
    input  wire [7:0]  i_g1,                 // med_g1
    output reg  [1:0]  o_cls,                // 00 鏈煡 / 01 鍦?/ 10 鐭?    output reg         o_upd,                // 绫诲埆鏇存柊鑴夊啿锛? 鎷嶏級
    output wire [10:0] o_bx0,                // 鍓嶆櫙 bbox锛堝抚閿佸瓨锛岀浉鏈哄潗鏍囷級
    output wire [10:0] o_bx1,
    output wire [10:0] o_by0,
    output wire [10:0] o_by1,
    output wire        o_box_en              // 1 = 鏈抚鍒嗙被鎴愮珛锛堢敾妫€娴嬫锛?);

    //--------------------------------------------------------------------------
    // 1. 鍓嶆櫙鍒ゅ畾锛圧3锛氬弻渚ц嚜閫傚簲闃堝€硷級
    //    甯у潎鍊?mu 鈮?危g/2^21锛?920脳1080=2,073,600鈮?^21锛岃宸?1.1%锛?    //    鍓嶆櫙 = 姣斿潎鍊兼槑鏄句寒 鎴?鏄庢樉鏆?鈫?鐧藉簳榛戠墿 / 鏆楀簳浜墿 閫氱敤锛屾棤闇€ POLARITY
    //--------------------------------------------------------------------------
    reg  [31:0] sum_g;
    reg  [31:0] s_sg;
    reg         vs_dg;
    wire        vs_rg = i_vs & ~vs_dg;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            sum_g <= 32'd0; s_sg <= 32'd0; vs_dg <= 1'b0;
        end else begin
            vs_dg <= i_vs;
            if (vs_rg) begin
                s_sg  <= sum_g;          // 涓婁竴甯ф€荤伆搴?                sum_g <= 32'd0;
            end else if (i_de) begin
                sum_g <= sum_g + {23'd0, i_g0} + {23'd0, i_g1};
            end
        end
    end

    wire [8:0] mu    = s_sg[29:21];                              // 甯у潎鍊?    wire [8:0] th_hi = mu + {1'b0, TH_DELTA};

    // 鏋佹€э紙R7锛夛細鐢便€岀敾闈㈠洓鍛ㄧ殑杈规甯︺€嶅垽瀹氳儗鏅紝鑰屼笉鏄敱甯у潎鍊煎垽
    //   鑳屾櫙涓€鑸欢浼稿埌鐢婚潰杈圭紭 鈫?杈规甯﹂噷鍗犲鏁扮殑閭ｄ竴绫绘槸鑳屾櫙锛屽彟涓€绫绘墠鏄洰鏍?    //   濂藉锛氱洰鏍囧崰鐢婚潰 70% 鏃讹紝鍧囧€艰鐩爣鎷夐珮涔熶笉浼氬垽鍙嶏紙R6 鐨勫け璐ユā寮忥級
    reg  pol_r;                                  // 甯ч攣瀛橈紙涓婁竴甯х粺璁＄粨鏋滐級

    wire fg0 = (TH_MODE == 0)
             ? (pol_r ? ({1'b0,i_g0} <= {1'b0,THRESH}) : ({1'b0,i_g0} > {1'b0,THRESH}))
             : (pol_r ? (mu > ({1'b0,i_g0} + {1'b0,TH_DELTA}))
                      : ({1'b0,i_g0} > th_hi));
    wire fg1 = (TH_MODE == 0)
             ? (pol_r ? ({1'b0,i_g1} <= {1'b0,THRESH}) : ({1'b0,i_g1} > {1'b0,THRESH}))
             : (pol_r ? (mu > ({1'b0,i_g1} + {1'b0,TH_DELTA}))
                      : ({1'b0,i_g1} > th_hi));

    //--------------------------------------------------------------------------
    // 2. 鍒楀彿 / 琛屽彿
    //--------------------------------------------------------------------------
    reg [9:0] pcol;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)                        pcol <= 10'd0;
        else if (!i_de)                    pcol <= 10'd0;
        else if (pcol == (H_PAIRS - 1))    pcol <= 10'd0;
        else                               pcol <= pcol + 10'd1;
    end

    wire [11:0] x0 = {1'b0, pcol, 1'b0};     // 2*pcol
    wire [11:0] x1 = x0 + 12'd1;

    reg  [11:0] row;
    reg  [20:0] y2;                          // row虏
    reg         de_d;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            row <= 12'd0; y2 <= 21'd0; de_d <= 1'b0;
        end else begin
            de_d <= i_de;
            if (i_vs) begin
                row <= 12'd0;
                y2  <= 21'd0;
            end else if (de_d && !i_de) begin           // 琛岀粨鏉?                row <= row + 12'd1;
                y2  <= y2 + {row, 1'b0} + 21'd1;        // +2*row+1 鈫?(row+1)虏
            end
        end
    end

    //--------------------------------------------------------------------------
    // 3. 澧為噺鍧愭爣閲忥紙鍏ㄩ儴棰勭敓鎴愬苟鎵撴媿锛屼笉杩涚粍鍚堜箻娉曪級
    //    pcol 鈫?pcol+1 鏃讹細 x0虏 += 8*pcol+4 锛? x1虏 += 8*pcol+8
    //                       y路x0 += 2y      锛? y路x1 += 2y
    //--------------------------------------------------------------------------
    reg [21:0] xsq0, xsq1;
    reg [21:0] yx0,  yx1;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            xsq0 <= 22'd0; xsq1 <= 22'd1; yx0 <= 22'd0; yx1 <= 22'd0;
        end else if (!i_de) begin                       // 琛岄/娑堥殣 鈫?瑁呰浇鍒濆€?            xsq0 <= 22'd0;
            xsq1 <= 22'd1;
            yx0  <= 22'd0;
            yx1  <= {10'd0, row};                       // y路x1 = y路1
        end else begin
            xsq0 <= xsq0 + {pcol, 3'b0} + 22'd4;
            xsq1 <= xsq1 + {pcol, 3'b0} + 22'd8;
            yx0  <= yx0  + {row, 1'b0};
            yx1  <= yx1  + {row, 1'b0};
        end
    end

    //--------------------------------------------------------------------------
    // 4. 鍗曢亶绱姞锛堥潰绉喕缁撳湪 30721锛屼繚璇佷綅瀹斤級
    //--------------------------------------------------------------------------
    // R4锛氱粺璁℃敼鍒?1/16 閲囨牱鍩燂紙姣?4脳4 鍧楀彇 1 涓牱鏈級锛屾敮鎸?鐩爣鍗犲崐灞?
    //     鍗婂睆 鈮?1.04e6 px 鈫?65,000 鏍锋湰锛屼粛鍦?16bit 闈㈢Н + 鐜版湁涓茶寮曟搸浣嶅鍐?    wire        smp       = (row[1:0] == 2'b00) && (pcol[0] == 1'b0);
    reg  [15:0] area;
    reg  [26:0] sum_x;
    reg  [26:0] sum_y;
    reg  [37:0] sum_xx;
    reg  [36:0] sum_yy;
    reg  [37:0] sum_xy;

    wire        area_full = (area >= 16'd65530);
    wire        acc_en    = i_de && smp && !area_full;

    wire [12:0] add_sx  = fg0 ? {1'b0, x0} : 13'd0;
    wire [12:0] add_sy  = fg0 ? row : 12'd0;
    wire [22:0] add_sxx = fg0 ? xsq0 : 22'd0;
    wire [21:0] add_syy = fg0 ? y2  : 21'd0;
    wire [22:0] add_sxy = fg0 ? yx0 : 22'd0;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            area <= 16'd0; sum_x <= 27'd0; sum_y <= 27'd0;
            sum_xx <= 38'd0; sum_yy <= 37'd0; sum_xy <= 38'd0;
        end else if (i_vs) begin
            area <= 16'd0; sum_x <= 27'd0; sum_y <= 27'd0;
            sum_xx <= 38'd0; sum_yy <= 37'd0; sum_xy <= 38'd0;
        end else if (acc_en) begin
            area   <= area + {15'd0, fg0};
            sum_x  <= sum_x  + add_sx;
            sum_y  <= sum_y  + add_sy;
            sum_xx <= sum_xx + add_sxx;
            sum_yy <= sum_yy + add_syy;
            sum_xy <= sum_xy + add_sxy;
        end
    end

    //--------------------------------------------------------------------------
    // 4b. 杈规甯︾粺璁?鈫?鏋佹€у垽瀹氾紙R7锛?    //     甯﹀唴 = x<96 / x>=W-96 / y<64 / y>=H-64锛堢害 22% 鐨勫儚绱狅紝鎸?1/16 閲囨牱鍚?~2.8 涓囦釜锛?    //     甯﹀唴浜儚绱犲 鈫?鑳屾櫙浜?鈫?鍙栨殫鐩爣锛涘惁鍒欑浉鍙?    //--------------------------------------------------------------------------
    wire in_band = (x0 < 12'd96) || (x0 >= (H_PAIRS*2 - 96)) ||
                   (row < 12'd64) || (row >= (V_LINES - 64));
    reg [14:0] bnd_hi, bnd_lo;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            bnd_hi <= 15'd0; bnd_lo <= 15'd0; pol_r <= 1'b0;
        end else if (vs_rg) begin
            pol_r  <= (bnd_hi > bnd_lo);          // 杈规甯﹀亸浜?鈫?鑳屾櫙浜?鈫?鐩爣鍙栨殫
            bnd_hi <= 15'd0;
            bnd_lo <= 15'd0;
        end else if (i_de && smp && in_band) begin
            if (i_g0 > THRESH) bnd_hi <= bnd_hi + 15'd1;
            else               bnd_lo <= bnd_lo + 15'd1;
        end
    end

    //--------------------------------------------------------------------------
    // 5. bbox锛堟湰闃舵涓嶅弬涓庡垽瀹氾紝棰勭暀缁欏悗缁?CCL/澶氱洰鏍囷紱鏈娇鐢ㄤ細琚患鍚堣鎺夛級
    //--------------------------------------------------------------------------
    reg [10:0] bbx0, bbx1, bby0, bby1;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n || i_vs) begin
            bbx0 <= 11'h7FF; bbx1 <= 11'd0; bby0 <= 11'h7FF; bby1 <= 11'd0;
        end else if (acc_en) begin
            if (fg0) begin
                if (x0[10:0] < bbx0) bbx0 <= x0[10:0];
                if (x0[10:0] > bbx1) bbx1 <= x0[10:0];
                if (row[10:0] < bby0) bby0 <= row[10:0];
                if (row[10:0] > bby1) bby1 <= row[10:0];
            end
        end
    end

    //--------------------------------------------------------------------------
    // 6. 甯ф湯蹇収 + 鍚姩鏁板寮曟搸锛坴s 涓婂崌娌匡紝閬垮厤 vs 楂樼數骞虫湡闂撮噸澶嶈Е鍙戯級
    //--------------------------------------------------------------------------
    reg        vs_d;
    wire       vs_rise = i_vs & ~vs_d;

    reg [15:0] s_area;
    reg [26:0] s_sx;
    reg [26:0] s_sy;
    reg [37:0] s_sxx;
    reg [36:0] s_syy;
    reg [37:0] s_sxy;
    reg        start;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            vs_d <= 1'b0; start <= 1'b0;
            s_area <= 16'd0; s_sx <= 27'd0; s_sy <= 27'd0;
            s_sxx <= 38'd0; s_syy <= 37'd0; s_sxy <= 38'd0;
        end else begin
            vs_d  <= i_vs;
            start <= 1'b0;
            if (vs_rise) begin
                s_area <= area;   s_sx  <= sum_x;  s_sy  <= sum_y;
                s_sxx  <= sum_xx; s_syy <= sum_yy; s_sxy <= sum_xy;
                start  <= 1'b1;
            end
        end
    end

    //--------------------------------------------------------------------------
    // 6b. bbox 蹇収 + 鍚堢悊鎬ф嫆缁濓紙R3 鏂板锛?    //     鎷掔粷鏉′欢锛氭棤鍓嶆櫙 / 瑙﹁竟锛堣儗鏅潅鐗╄鎴柇锛? bbox 杩囧杩囬珮锛堝ぇ鑳屾櫙鍧楋級
    //     鍛戒腑浠讳竴 鈫?绫诲埆寮哄埗涓?鏈煡"锛屽畞鍙笉鍒や篃涓嶉敊鍒?    //--------------------------------------------------------------------------
    reg [10:0] s_bx0, s_bx1, s_by0, s_by1;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            s_bx0 <= 11'h7FF; s_bx1 <= 11'd0; s_by0 <= 11'h7FF; s_by1 <= 11'd0;
        end else if (vs_rise) begin
            s_bx0 <= bbx0; s_bx1 <= bbx1; s_by0 <= bby0; s_by1 <= bby1;
        end
    end

    wire [11:0] bw = (s_bx1 >= s_bx0) ? ({1'b0,s_bx1} - {1'b0,s_bx0} + 12'd1) : 12'd0;
    wire [11:0] bh = (s_by1 >= s_by0) ? ({1'b0,s_by1} - {1'b0,s_by0} + 12'd1) : 12'd0;

    wire rej_empty = (s_bx1 < s_bx0) || (s_by1 < s_by0);
    wire rej_touch = (s_bx0 == 11'd0) || (s_by0 == 11'd0) ||
                     (s_bx1 >= (H_PAIRS*2 - 1)) || (s_by1 >= (V_LINES - 1));
    wire rej_big   = (bw > BBX_MAX) || (bh > BBY_MAX);
    wire rej_all   = rej_empty | rej_touch | rej_big;

    //--------------------------------------------------------------------------
    // 6c. 濉厖搴︽鏌ワ紙R6锛?    //     fill = A_true/bbox_px = 16路A/(bw路bh) 鈮?FILL_MIN/1024
    //     鉄?A路16384 鈮?FILL_MIN路bw路bh    锛圓路16384 鐢ㄧЩ浣嶏紝FILL_MIN 鐢ㄧЩ浣嶅姞锛?    //     浣滅敤锛氭暎涔卞櫔澹般€佹浣忓ぇ鐗囪儗鏅?鈫?濉厖搴︿綆 鈫?鐩存帴鎷掔粷
    //           杩欎篃鏄?绌哄満鏅粛鐒跺嚭妗?鐨勬牴娌伙細绌哄満鏅彧鍓╁櫔鐐癸紝濉厖搴︽瀬浣?    //--------------------------------------------------------------------------
    reg  [23:0] bwbh_r;
    reg         fill_ok_r;
    wire [23:0] bwbh_c = bw * bh;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            bwbh_r <= 24'd0; fill_ok_r <= 1'b0;
        end else begin
            bwbh_r    <= bwbh_c;                                   // 12脳12 涔樻硶锛岀嫭绔嬩竴绾?            fill_ok_r <= ({11'd0, s_area} << 14) >=               // A_true路1024
                         ((bwbh_r << 8) + (bwbh_r << 5) +
                          (bwbh_r << 3) + bwbh_r);                 // FILL_MIN路bw路bh
        end
    end

    // 渚?OSD 鐢绘娴嬫锛堝抚閿佸瓨鍊硷級
    assign o_bx0 = s_bx0; assign o_bx1 = s_bx1;
    assign o_by0 = s_by0; assign o_by1 = s_by1;
    assign o_box_en = (o_cls != 2'd0);                             // 鍙湪鍒嗙被鎴愮珛鏃剁敾妗?
    //--------------------------------------------------------------------------
    // 7. 涓茶鏁板寮曟搸 + 缁撴灉闂搁棬
    //--------------------------------------------------------------------------
    wire [1:0] cls_eng;
    wire       eng_done;

    shape_math u_math (
        .clk     (clk),
        .rst_n   (rst_n),
        .i_start (start),
        .i_area  (s_area),
        .i_sx    (s_sx),
        .i_sy    (s_sy),
        .i_sxx   (s_sxx),
        .i_syy   (s_syy),
        .i_sxy   (s_sxy),
        .o_cls   (cls_eng),
        .o_done  (eng_done)
    );

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            o_cls <= 2'd0; o_upd <= 1'b0;
        end else begin
            o_upd <= eng_done;
            if (eng_done)
                o_cls <= (rej_all | ~fill_ok_r) ? 2'd0 : cls_eng;   // bbox 涓嶅悎鐞?濉厖搴︿綆 鈫?鏈煡
        end
    end

endmodule


//==============================================================================
// shape_math 鈥斺€?甯ф湯涓茶涔橀櫎 + 鍒嗙被
//
//   鏁版嵁閫氳矾锛?4bit 绉讳綅/绱姞 + 32bit 鎿嶄綔鏁?+ 33bit 浣欐暟 + 64bit 鍟?//             锛堜綑鏁?33bit锛?/16 閲囨牱鍚庨櫎鏁?A虏 鍙揪 4.29e9锛屽繀椤?> 2^31锛?//   涔樻硶锛氱Щ浣嶅姞锛孨 鎷嶏紙N = 涔樻暟浣嶅锛?//   闄ゆ硶锛氭仮澶嶄綑鏁帮紝64 鎷?//   涓€甯т竴鍏?10 涔?+ 4 闄?+ 鑻ュ共鐩撮€氭 鈮?490 鎷?鈮?6.6us @74.25MHz
//   锛?080p 鍨傜洿娑堥殣鏈?~600us锛屼綑閲忕害 100 鍊嶏級
//
//   鎵€鏈夌粨鏋滈兘鐢ㄦ暣鏁拌〃绀猴紝闃堝€兼潵鑷畻娉曚豢鐪燂細
//     c_g  鈮?1.965  鉄? A路2^12/6.1732296 鈮?tr_q12  鉄? A路10616 鈮?tr_q12
//     f_mom鈮?0.965  鉄? LQ/A虏 鈮?65536/(144路0.965虏) = 488.72 鈫?W 鈮?488
//==============================================================================
module shape_math (
    input  wire        clk,
    input  wire        rst_n,
    input  wire        i_start,
    input  wire [15:0] i_area,
    input  wire [26:0] i_sx,
    input  wire [26:0] i_sy,
    input  wire [37:0] i_sxx,
    input  wire [36:0] i_syy,
    input  wire [37:0] i_sxy,
    output reg  [1:0]  o_cls,
    output reg         o_done
);

    localparam [4:0] RUN_MUL = 5'd30;
    localparam [4:0] RUN_DIV = 5'd31;

    reg [4:0]  pc, ret;
    reg [6:0]  cnt;

    reg [63:0] sh;          // 涔樻硶琚箻鏁?/ 闄ゆ硶琚櫎鏁帮紙梅 鏈熼棿鍘熷湴鍙樻垚鍟嗭級
    reg [31:0] b;           // 涔樻硶涔樻暟   / 闄ゆ硶闄ゆ暟
    reg [63:0] acc;         // 涔樼Н绱姞
    // 闄ゆ硶浣欐暟 33bit锛?/16 閲囨牱鍚?A 涓婇檺 65530 鈫?闄ゆ暟 A虏 鏈€澶?4.29e9 > 2^31锛?    // 蹇呴』鎸夊畬鏁?32bit 鍙備笌姣旇緝锛涙仮澶嶄綑鏁版硶鐨勪腑闂撮噺 rem_nxt = 2路rem + bit < 2路b锛?    // 鏁?33bit 鏄?b 鈮?2^32-1 鏃剁殑鏈€灏忓畨鍏ㄤ綅瀹斤紙鍘?31bit 浼氫涪鏈€楂樹綅骞跺拷鐣?b[31]锛夈€?    reg [32:0] rem;

    reg [15:0] a;
    reg [26:0] sx;
    reg [26:0] sy;
    reg [37:0] sxx;
    reg [36:0] syy;
    reg [37:0] sxy;

    reg [31:0] a2;
    reg [55:0] t1;
    reg [31:0] m20, m02, m11;
    reg [55:0] lq;
    reg [17:0] w;
    reg        circ;

    // 鍟嗛ケ鍜岋細W = LQ/A虏 鐞嗚鍙揪 42bit銆?8bit 瑕嗙洊鏈璁＄殑甯歌閲忕骇
    // 锛堝吀鍨?1e5锛屽垽鐭╅棬闄?125112 涔熷湪 18bit 鍐咃級锛岃秴鍑哄嵆璁版弧閲忕▼銆?    // 娉ㄦ剰锛歸 鍙綔瑙傛祴锛屽垽鐭╃敤鐨勬槸銆孡Q 鈮?125112路A虏銆嶇殑涔樺悗姣旇緝銆?    wire [17:0] w_sat = (|sh[63:18]) ? 18'h3FFFF : sh[17:0];

    // 闄ゆ硶涓€鎷嶏細浣欐暟宸︾Щ杩涜闄ゆ暟鏈€楂樹綅锛屽鍑忓垯缃晢 1
    //   闄ゆ暟鎸夊畬鏁?32bit 瀵归綈锛坆 鏄?32bit 瀵勫瓨鍣紝鏁呮墿灞曚綅鍙湁 1 涓?鈫?33bit 姣旇緝锛?    wire [32:0] rem_nxt = {rem[31:0], sh[63]};
    wire [32:0] b_ext   = {1'b0, b};
    wire        ge      = (rem_nxt >= b_ext);
    wire [32:0] rem_sub = rem_nxt - b_ext;

    // LQ = m20鈧埪穖02鈧?鈭?m11鈧埪诧紙缁勫悎鍊硷細鏃㈠啓瀵勫瓨鍣紝涔熺洿鎺ュ綋绗?4 涓櫎娉曠殑琚櫎鏁帮級
    wire [55:0] lq_c = (t1 >= acc[55:0]) ? (t1 - acc[55:0]) : 56'd0;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            pc <= 5'd0; ret <= 5'd0; cnt <= 7'd0;
            sh <= 64'd0; b <= 32'd0; acc <= 64'd0; rem <= 33'd0;
            a <= 16'd0; sx <= 26'd0; sy <= 25'd0;
            sxx <= 37'd0; syy <= 36'd0; sxy <= 36'd0;
            a2 <= 32'd0; t1 <= 56'd0; m20 <= 32'd0; m02 <= 32'd0; m11 <= 32'd0;
            lq <= 56'd0; w <= 18'd0; circ <= 1'b0; o_cls <= 2'd0; o_done <= 1'b0;
        end else begin
            o_done <= 1'b0;

            if (pc == RUN_MUL) begin
                acc  <= acc + (b[0] ? sh : 64'd0);
                sh   <= {sh[62:0], 1'b0};
                b    <= {1'b0, b[31:1]};
                cnt  <= cnt - 7'd1;
                if (cnt == 7'd1) pc <= ret;

            end else if (pc == RUN_DIV) begin
                rem  <= ge ? rem_sub : rem_nxt;
                sh   <= {sh[62:0], ge};      // 鍟嗕粠鏈€浣庝綅鍘熷湴绉诲叆锛岀渷鎺夌嫭绔嬪晢瀵勫瓨鍣?                cnt  <= cnt - 7'd1;
                if (cnt == 7'd1) pc <= ret;

            end else begin
                case (pc)
                //--------------------------------------------------------------
                5'd0: if (i_start) begin                 // 閿佸瓨缁熻閲?                    a <= i_area; sx <= i_sx; sy <= i_sy;
                    sxx <= i_sxx; syy <= i_syy; sxy <= i_sxy;
                    pc <= 5'd1;
                end
                //--------------------------------------------------------------
                5'd1: begin                              // A*A
                    sh <= {48'd0, a}; b <= {16'd0, a}; cnt <= 7'd16;
                    acc <= 64'd0; ret <= 5'd2; pc <= RUN_MUL;
                end
                5'd2: begin                              // a2 = A虏
                    a2 <= acc[31:0];
                    sh <= {37'd0, sx}; b <= {5'd0, sx}; cnt <= 7'd27;
                    acc <= 64'd0; ret <= 5'd3; pc <= RUN_MUL;
                end
                5'd3: begin                              // t1 = 危x虏
                    t1 <= acc[55:0];
                    sh <= {26'd0, sxx}; b <= {16'd0, a}; cnt <= 7'd16;
                    acc <= 64'd0; ret <= 5'd4; pc <= RUN_MUL;
                end
                5'd4: begin                              // m20 = (A路危xx 鈭?危x虏)路2^12 / A虏
                    sh <= (acc - {8'd0, t1}) << 12;
                    b  <= a2[31:0]; cnt <= 7'd64;
                    rem <= 33'd0; ret <= 5'd5; pc <= RUN_DIV;
                end
                5'd5: begin
                    m20 <= sh[31:0];
                    sh <= {37'd0, sy}; b <= {5'd0, sy}; cnt <= 7'd27;
                    acc <= 64'd0; ret <= 5'd6; pc <= RUN_MUL;
                end
                5'd6: begin                              // t1 = 危y虏
                    t1 <= acc[55:0];
                    sh <= {27'd0, syy}; b <= {16'd0, a}; cnt <= 7'd16;
                    acc <= 64'd0; ret <= 5'd7; pc <= RUN_MUL;
                end
                5'd7: begin                              // m02
                    sh <= (acc - {8'd0, t1}) << 12;
                    b  <= a2[31:0]; cnt <= 7'd64;
                    rem <= 33'd0; ret <= 5'd8; pc <= RUN_DIV;
                end
                5'd8: begin
                    m02 <= sh[31:0];
                    sh <= {37'd0, sx}; b <= {5'd0, sy}; cnt <= 7'd27;
                    acc <= 64'd0; ret <= 5'd9; pc <= RUN_MUL;
                end
                5'd9: begin                              // t1 = 危x路危y
                    t1 <= acc[55:0];
                    sh <= {26'd0, sxy}; b <= {16'd0, a}; cnt <= 7'd16;
                    acc <= 64'd0; ret <= 5'd10; pc <= RUN_MUL;
                end
                5'd10: begin                             // m11 = |R|路2^12 / A虏
                    // 鍗忔柟宸?R 鍙兘涓鸿礋锛堟爡鏍煎寲 / 闈㈢Н鍐荤粨瀵艰嚧鐨勮交寰笉瀵圭О锛夛紱
                    // m11 鍙互骞虫柟褰㈠紡杩涘叆 LQ锛屽彇缁濆鍊间笉褰卞搷鍒ゆ嵁銆?                    sh <= ((acc >= {8'd0, t1}) ? (acc - {8'd0, t1})
                                               : ({8'd0, t1} - acc)) << 12;
                    b  <= a2[31:0]; cnt <= 7'd64;
                    rem <= 33'd0; ret <= 5'd11; pc <= RUN_DIV;
                end
                5'd11: begin
                    m11 <= sh[31:0];
                    // 鍦嗗垽鎹細a路10616 鈮?m20+m02锛圦12锛?                    //   c_g = A_true/(蟺路tr)锛孉_true = 16路a锛?/16 閲囨牱锛?                    //   鉄?16路a路4096 鈮?1.965蟺路(m20+m02) 鉄?a路10616 鈮?tr
                    circ <= ({16'd0, a} * 16'd10616 >= {1'b0, m20} + {1'b0, m02});
                    // LQ 鐨勭 1 涓箻鏁?                    sh <= {36'd0, m20[31:4]};
                    b  <= {4'd0,  m02[31:4]};
                    cnt <= 7'd28; acc <= 64'd0; ret <= 5'd12; pc <= RUN_MUL;
                end
                5'd12: begin                             // t1 = m20鈧埪穖02鈧?                    t1 <= acc[55:0];
                    sh <= {36'd0, m11[31:4]};
                    b  <= {4'd0,  m11[31:4]};
                    cnt <= 7'd28; acc <= 64'd0; ret <= 5'd13; pc <= RUN_MUL;
                end
                5'd13: begin                             // LQ = m20鈧埪穖02鈧?鈭?m11鈧埪? (鈮?)
                    // t1 = 绗竴涓箻绉紝acc = 绗簩涓箻绉?鈫?蹇呴』 t1 鈭?acc
                    lq <= lq_c;
                    // W = LQ/A虏 鈥斺€?鏂囨。閲岀殑绗?4 涓櫎娉曘€?                    //   鍙綔**瑙傛祴鎶藉ご**锛堢粰瀵规媿鐢級锛屽垽鐭╀粛璧颁笅闈㈢殑銆屼箻鍚庢瘮杈冦€嶏紝
                    //   鍥犳 w 涓嶅弬涓?o_cls锛岀患鍚堜細鎶婅繖鏉￠櫎娉曢摼瑁佹帀锛堣祫婧愪负 0 澧為噺锛夈€?                    sh <= {8'd0, lq_c};
                    b  <= a2;
                    cnt <= 7'd64; rem <= 33'd0; ret <= 5'd14; pc <= RUN_DIV;
                end
                5'd14: begin
                    w <= w_sat;                          // 18bit 楗卞拰锛?0x3FFFF 璁版弧閲忕▼锛?                    // 鐭╁舰鍒ゆ嵁"涔樺悗姣旇緝"锛歀Q 鈮?125112路A虏
                    //   绛変环 f_mom = 16a/(12鈭?位1位2)) 鈮?0.965锛圓_true = 16a锛?                    sh <= {32'd0, a2};
                    b  <= {15'd0, 17'd125112};
                    cnt <= 7'd17; acc <= 64'd0; ret <= 5'd15; pc <= RUN_MUL;
                end
                5'd15: begin                             // 鍒ょ被
                    o_cls <= ((a >= 16'd150) && (a <= 16'd65530)) ?
                             (circ ? 2'd1 : ((lq <= acc[55:0]) ? 2'd2 : 2'd0)) : 2'd0;
                    o_done <= 1'b1;
                    pc <= 5'd0;
                end
                //--------------------------------------------------------------
                default: pc <= 5'd0;
                endcase
            end
        end
    end

endmodule
